# ─────────────────────────────────────────────────────────────────────────────
# WCM production settings. install.sh copies this to deploy/.env and fills the
# secrets for you. Never commit deploy/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Your web address. Point its DNS "A" record to this server's IP first.
# One name, or several separated by a comma: "example.in, www.example.in"
DOMAIN=wcm.example.in
# Let's Encrypt sends certificate notices here
ACME_EMAIL=you@example.in

# Company code used at sign-in when the server hosts one firm (created with create-company.sh)
DEFAULT_COMPANY=sd

# ---- secrets: install.sh generates these (openssl rand -hex 32) ----
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- behaviour ----
# a client server has no demo company
DEMO_COMPANY=off
# sign-in session length in hours
SESSION_HOURS=12
# the app's own daily backup inside the database, kept this many days
BACKUP_KEEP_DAYS=30
# nightly pg_dump of the whole database to deploy/backups, kept this many days
DB_BACKUP_KEEP_DAYS=14
# API reference at /api/docs (keep off on a live server)
API_DOCS=off

# ---- optional: SMS one-time passwords (MSG91) ----
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---- optional: off-site copy of backups to S3-compatible storage ----
BACKUP_S3=off
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
