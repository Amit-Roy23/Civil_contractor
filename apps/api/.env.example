PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/civil_erp
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=civil-erp-development-jwt-access-token-secret-key-32chars
JWT_REFRESH_SECRET=civil-erp-development-jwt-refresh-token-secret-key-32chars
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=civil-erp-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
CORS_ORIGIN=http://localhost:5173

# ---- v2 (server mode for the web app) ----
# Business time zone for dates, attendance locks and back-dating
BUSINESS_TZ=Asia/Kolkata
# Demo company with sample data, created on first start ("off" to disable — do this for a client-only server)
DEMO_COMPANY=demo
DEMO_PASSWORD=demo@123
# One-click role cards on the login page for the demo company
DEMO_ONE_CLICK=true
# Company used when the login form has no company code (needed only if the server hosts several clients)
DEFAULT_COMPANY=
# Login session length in hours
SESSION_HOURS=12
# OTP by SMS (MSG91 flow template with an ##otp## variable). Without these, OTP codes are only logged (not in production)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
